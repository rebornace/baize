# 本地调试完整配置：复制为 configs/config.local.yaml（已 gitignore，勿提交）。
# 运行：baize serve -config configs/config.local.yaml
# 密钥放 .env 或环境变量：BAIZE_API_KEY=sk-...
listen: ":8080"
# runtime:
#   public_base_url: "http://127.0.0.1:8080"  # empty => do not inject callback_urls
#   callback_hmac_secret: ""
#   callback_token_ttl_sec: 3600
store:
  driver: sqlite
  sqlite_path: ./data/baize.db
ui:
  enabled: true
control_plane:
  operator_token: ""
  admin_token: ""
llm:
  provider: openai_compatible
  base_url: https://api.example.com
  model: your-model
  api_key_env: BAIZE_API_KEY
  disable_thinking: true
  # supports_vision: false   # default; set true for vision-capable models (e.g. gpt-4o)
skills:
  builtin_dir: ./skills
  user_dir: ./data/skills
agent:
  id: local-agent
  system: "你是业务助手，只能通过已注册工具访问后端 API。"
# 本地要对接的真实系统接口文档放在被 gitignore 的目录（见 examples/local/README.md），
# 切勿把真实系统地址、接口文档或账号信息提交到仓库。
connector:
  id: example-connector
  type: openapi
  spec: examples/local/openapi.json
  base_url: https://api.example.com
  require_approval_mutating: true
  auth:
    mode: static
    capture:
      tool_name_glob: "*login*"
      token_json_paths: ["accessToken", "data.accessToken", "data.token"]
      label_json_paths: ["email", "data.email"]
      header_template: "Bearer {{token}}"
      default_scheme: bearer
run:
  max_steps: 20
  tool_timeout_sec: 60
conversation:
  max_messages: 40
  persist_identities: true
storage:
  driver: file
inbox:
  channels: []
