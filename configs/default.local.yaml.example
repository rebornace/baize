# 本地调试覆盖（复制为 configs/default.local.yaml，勿提交）
# 密钥放 .env：BAIZE_API_KEY=sk-...
# baize demo 会加载：demo.yaml → default.local.yaml → demo.local.yaml（后者优先）
listen: ":8080"
store:
  driver: sqlite
  sqlite_path: ./data/baize.db
ui:
  enabled: true
llm:
  provider: openai_compatible
  base_url: https://api.deepseek.com
  model: deepseek-chat
  api_key_env: BAIZE_API_KEY
  disable_thinking: true
  # supports_vision: false   # default; set true for vision-capable models (e.g. gpt-4o)
agent:
  id: miao-agent
  system: "你是业务助手，只能通过已注册工具访问后端 API。"
connector:
  id: doctor-miao
  type: openapi
  spec: examples/miaomiao/openapi.json
  base_url: https://www.miaomiaomiao.online
  require_approval_mutating: true
  auth:
    mode: static
    capture:
      tool_name_glob: "*login*"
      token_json_paths: ["accessToken", "data.accessToken", "data.token"]
      label_json_paths: ["email", "data.email"]
      header_template: "Bearer {{token}}"
      default_scheme: bearer
run:
  max_steps: 20
  tool_timeout_sec: 60
mock_ticket:
  listen: off
