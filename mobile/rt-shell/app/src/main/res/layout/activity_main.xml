<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/apiBase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="API base (e.g. http://10.0.2.2:18080/v1)"
        android:inputType="textUri"
        android:text="http://10.0.2.2:18080/v1" />

    <EditText
        android:id="@+id/apiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="API key (vault)"
        android:inputType="textPassword"
        android:text="" />

    <EditText
        android:id="@+id/model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="model"
        android:text="mock" />

    <EditText
        android:id="@+id/configUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Remote config URL (optional JSON)"
        android:inputType="textUri" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/saveVault"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save vault" />
        <Button
            android:id="@+id/fetchConfig"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fetch config" />
    </LinearLayout>

    <EditText
        android:id="@+id/userInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="User message"
        android:text="你好 MOBILE-RT" />

    <Button
        android:id="@+id/send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send (tools + HITL)" />

    <LinearLayout
        android:id="@+id/hitlRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">
        <Button
            android:id="@+id/approve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Approve" />
        <Button
            android:id="@+id/deny"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Deny" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="Keys stay in Android EncryptedSharedPreferences; Go holds them only in memory." />
    </ScrollView>
</LinearLayout>
