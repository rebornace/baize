{
  "name": "baize-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Capacitor shell for the Baize operator console (client to a remote baize Runtime)",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "dotenv": "^16.6.1"
  }
}
