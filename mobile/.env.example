# --- Recommended for chat SSE: load remote /ui same-origin ---
# Phone-reachable baize root (no trailing slash). WebView opens <url>/ui/.
BAIZE_SERVER_URL=http://192.168.1.10:8080

# --- Or bundled www (offline shell assets) ---
# Leave BAIZE_SERVER_URL unset, set API origin, and on the Runtime host:
#   set BAIZE_CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost
# BAIZE_API_ORIGIN=http://192.168.1.10:8080
